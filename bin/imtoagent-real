#!/usr/bin/env bun
// ================================================================
// imtoagent CLI — global command entry point
// ================================================================
// Available after npm install -g imtoagent:
//   imtoagent setup    — interactive setup wizard
//   imtoagent start    — start gateway in background
//   imtoagent run      — start gateway in foreground
//   imtoagent stop     — stop gateway
//   imtoagent status   — check running status
//   imtoagent restore  — hot reload
//   imtoagent daemon   — foreground daemon (auto-restart, for launchd/systemd)
// ================================================================

import * as fs from 'fs';
import * as path from 'path';
import * as readline from 'readline';
import { spawn, execSync } from 'child_process';
import { getDataDir, getLogsDir } from '../modules/utils/paths';

const PID_FILE = '/tmp/imtoagent.pid';

// ================================================================
// Command dispatch
// ================================================================
const command = process.argv[2];

switch (command) {
  case 'setup':
    await cmdSetup(process.argv[3]);
    break;
  case 'start':
    await cmdStart();
    break;
  case 'run':
    await cmdRun();
    break;
  case 'stop':
    await cmdStop();
    break;
  case 'status':
    await cmdStatus();
    break;
  case 'restore':
    await cmdRestore();
    break;
  case 'daemon':
    await cmdDaemon();
    break;
  case 'update-system':
    await cmdUpdateSystem();
    break;
  case 'update-backend': {
    const backendType = process.argv[3] as 'claude' | 'codex' | 'opencode' | 'gemini' | undefined;
    await cmdUpdateBackend(backendType);
    break;
  }
  case 'uninstall':
    await cmdUninstall();
    break;
  case 'health':
    await cmdHealth();
    break;
  case 'doctor':
    await cmdDoctor();
    break;
  case 'config':
    await cmdConfig();
    break;
  case 'autostart':
    await cmdAutostart();
    break;
  case 'logs':
    await cmdLogs();
    break;
  case 'validate':
    await cmdValidate();
    break;
  case 'stats':
    await cmdStats(...process.argv.slice(3));
    break;
  case 'session':
    await cmdSession(...process.argv.slice(3));
    break;
  case 'healthz':
    await cmdHealthz(...process.argv.slice(3));
    break;
  case 'providers':
    await cmdProviders(...process.argv.slice(3));
    break;
  case 'mcp':
    await cmdMcp(...process.argv.slice(3));
    break;
  case 'skills':
    await cmdSkills(...process.argv.slice(3));
    break;
  case 'prompts':
    await cmdPrompts(...process.argv.slice(3));
    break;
  case undefined: {
    const dataDir = getDataDir();
    const configPath = path.join(dataDir, 'config.json');
    let needsSetup = !fs.existsSync(configPath);
    if (!needsSetup) {
      try {
        const raw = fs.readFileSync(configPath, 'utf-8');
        needsSetup = /YOUR_[A-Z_]+/.test(raw);
      } catch { needsSetup = true; }
    }
    if (needsSetup) {
      console.log('👋 Welcome to imtoagent! Please run setup first.\n');
      await cmdSetup();
    } else {
      printHelp();
    }
    break;
  }
  case 'version':
  case '--version':
  case '-v':
    const pkg = JSON.parse(fs.readFileSync(new URL('../package.json', import.meta.url), 'utf-8'));
    console.log(pkg.version);
    break;
  case 'help':
  case '--help':
  case '-h':
    printHelp();
    break;
  default:
    console.error(`❌ Unknown command: ${command}`);
    printHelp();
    process.exit(1);
}

// ================================================================
// Help
// ================================================================
function printHelp() {
  console.log(`
imtoagent — IM ↔ Agent Unified Gateway

Usage:
  imtoagent setup               Interactive setup wizard
  imtoagent setup --quick       Quick mode (sandbox workspace, skip workspace step)
  imtoagent start               Start gateway in background (returns immediately)
  imtoagent run                 Start gateway in foreground (Ctrl+C to stop)
  imtoagent stop                Stop gateway
  imtoagent status              Check running status
  imtoagent restore             Hot reload
  imtoagent daemon              Foreground daemon with auto-restart (for launchd/systemd)
  imtoagent update-system       Upgrade imtoagent itself
  imtoagent update-backend      Upgrade current Bot's backend
  imtoagent update-backend TYPE Upgrade specific backend (codex|claude|opencode)
  imtoagent uninstall           Uninstall imtoagent (keep data by default)
  imtoagent uninstall --purge   Uninstall and delete all data
  imtoagent health              Run comprehensive health check
  imtoagent doctor              Diagnose & fix configuration issues
  imtoagent config              Manage Bot configuration
  imtoagent config list         List all Bots
  imtoagent config show NAME    Show Bot details
  imtoagent config add          Add a new Bot
  imtoagent config remove NAME  Remove a Bot
  imtoagent config modify NAME  Modify Bot settings
  imtoagent autostart enable    Enable auto-start on login (launchd)
  imtoagent autostart disable   Disable auto-start
  imtoagent autostart status    Check auto-start status
  imtoagent logs                Show last 50 lines of log
  imtoagent logs -n N           Show last N lines
  imtoagent logs -f             Follow log in real-time (tail -f)
  imtoagent validate            Validate config.json for errors
  imtoagent stats               Show usage statistics (all time, per-bot)
  imtoagent stats --today       Today's usage
  imtoagent stats --week        This week's usage
  imtoagent stats --bot NAME    Filter by bot
  imtoagent stats --history -n  Recent call history
  imtoagent session list        List recent sessions
  imtoagent session list --all  List all sessions
  imtoagent session info <id>   Show session details
  imtoagent session clear <id>  Delete a session
  imtoagent session clear --all Delete all sessions
  imtoagent healthz             Quick health check (exit 0=OK, 1=unhealthy)
  imtoagent providers           List configured providers
  imtoagent providers presets   List available provider presets
  imtoagent providers add --preset <name> --key <key>
  imtoagent mcp list                          List MCP servers
  imtoagent mcp add <name> --command "cmd"    Add MCP server
  imtoagent mcp sync                          Sync to backend configs
  imtoagent skills list                       List installed skills
  imtoagent skills install <source>           Install from GitHub/ZIP/local
  imtoagent prompts list                      List saved prompts
  imtoagent prompts sync                      Sync to backend configs

Data directory: ${getDataDir()}
`);
}

// ================================================================
// setup — interactive wizard
// ================================================================
async function cmdSetup(mode) {
  const quick = mode === '--quick' || mode === '-q';
  const { runSetupWizard } = await import('../modules/cli/setup');
  await runSetupWizard(quick ? { quick: true } : undefined);
}

// ================================================================
// Shared: build gateway launch args
// ================================================================
function getGatewayArgs() {
  const pkgDir = path.resolve(import.meta.dirname, '..');
  const indexFile = path.join(pkgDir, 'index.ts');
  return { execPath: process.execPath, args: ['run', indexFile] };
}

function ensureLogDir(dataDir: string) {
  const logsDir = path.join(dataDir, 'logs');
  if (!fs.existsSync(logsDir)) fs.mkdirSync(logsDir, { recursive: true });
  return path.join(logsDir, 'imtoagent.log');
}

// ================================================================
// start — background mode (spawn detached, log to file, return immediately)
// ================================================================
async function cmdStart() {
  // Check if already running
  if (fs.existsSync(PID_FILE)) {
    const pid = parseInt(fs.readFileSync(PID_FILE, 'utf-8').trim());
    try {
      process.kill(pid, 0);
      console.error(`❌ Gateway already running (PID=${pid})`);
      console.error(`   Run "imtoagent stop" to stop first`);
      process.exit(1);
    } catch {
      fs.unlinkSync(PID_FILE);
    }
  }

  const dataDir = getDataDir();
  const configPath = path.join(dataDir, 'config.json');
  if (!fs.existsSync(configPath)) {
    console.error('❌ No config file found. Please run "imtoagent setup" first');
    process.exit(1);
  }

  // Backend check (non-blocking)
  try {
    const { checkBackend } = await import('../modules/utils/backend-check');
    const config = JSON.parse(fs.readFileSync(configPath, 'utf-8'));
    const missingBackends: string[] = [];
    for (const bot of config.bots || []) {
      if (bot.backend && ['claude', 'codex', 'opencode', 'gemini'].includes(bot.backend)) {
        const info = checkBackend(bot.backend as any);
        if (!info.installed && !missingBackends.includes(bot.backend)) {
          missingBackends.push(bot.backend);
        }
      }
    }
    if (missingBackends.length > 0) {
      console.error(`\n⚠️  The following backends are configured but not installed, messages will fail after gateway starts:`);
      for (const b of missingBackends) console.error(`   ❌ ${b}`);
      console.error(`\nPlease install the missing backends, or run "imtoagent setup" to reconfigure.\n`);
    }
  } catch {
    // Check failure doesn't block startup
  }

  const logFile = ensureLogDir(dataDir);

  console.log('🚀 Starting imtoagent gateway (background)...');
  console.log(`   Data directory: ${dataDir}`);
  console.log(`   Log file: ${logFile}`);

  const { execPath, args } = getGatewayArgs();
  const cmdLine = `"${execPath}" run "${path.resolve(import.meta.dirname, '..', 'index.ts')}"`;

  // Use a shell to launch the gateway in background — avoids event-loop blockers
  const shellCmd = `IMTOAGENT_HOME="${dataDir}" ${cmdLine} >> "${logFile}" 2>&1 &
PID=$!
echo $PID`;

  const { execSync } = await import('child_process');
  const pidStr = execSync(shellCmd, {
    cwd: dataDir,
    env: { ...process.env, IMTOAGENT_HOME: dataDir },
    encoding: 'utf-8',
    stdio: ['ignore', 'pipe', 'pipe'],
  }).trim();
  const gatewayPid = parseInt(pidStr.split('\n').pop()!);

  fs.writeFileSync(PID_FILE, String(gatewayPid));
  console.log(`✅ Gateway started (PID=${gatewayPid})`);

  // Wait for startup verification
  await new Promise(r => setTimeout(r, 3000));
  try {
    process.kill(gatewayPid, 0);
    console.log('✅ Gateway is running');
  } catch {
    console.error('❌ Gateway failed to start, check logs:');
    if (fs.existsSync(logFile)) {
      console.log(fs.readFileSync(logFile, 'utf-8').slice(-2000));
    }
    fs.unlinkSync(PID_FILE);
    process.exit(1);
  }

  // Non-blocking version check
  checkForUpdates().then(printUpdateHint).catch(() => {});

  // Explicitly exit — Bun may keep event loop alive due to inherited stdio
  process.exit(0);
}

// ================================================================
// run — foreground mode (real-time logs, Ctrl+C to stop)
// ================================================================
async function cmdRun() {
  const dataDir = getDataDir();
  const configPath = path.join(dataDir, 'config.json');
  if (!fs.existsSync(configPath)) {
    console.error('❌ No config file found. Please run "imtoagent setup" first');
    process.exit(1);
  }

  const logFile = ensureLogDir(dataDir);

  // Warn if already running in background
  if (fs.existsSync(PID_FILE)) {
    const pid = parseInt(fs.readFileSync(PID_FILE, 'utf-8').trim());
    try {
      process.kill(pid, 0);
      console.log(`⚠️  Gateway is already running in background (PID=${pid})`);
      console.log(`   Run "imtoagent stop" first, or this may conflict.\n`);
    } catch {
      fs.unlinkSync(PID_FILE);
    }
  }

  const { execPath, args } = getGatewayArgs();

  console.log('🚀 Starting imtoagent gateway (foreground mode)...');
  console.log('   Press Ctrl+C to stop');
  console.log('');

  const child = Bun.spawn([execPath, ...args], {
    cwd: dataDir,
    env: { ...process.env, IMTOAGENT_HOME: dataDir },
    stdout: 'pipe',
    stderr: 'pipe',
  });

  fs.writeFileSync(PID_FILE, String(child.pid));

  const logStream = fs.createWriteStream(logFile, { flags: 'a' });

  const pumpOut = (async () => {
    for await (const chunk of child.stdout as any) {
      const line = new TextDecoder().decode(chunk);
      process.stdout.write(line);
      logStream.write(line);
    }
  })().catch(() => {});

  const pumpErr = (async () => {
    for await (const chunk of child.stderr as any) {
      const line = new TextDecoder().decode(chunk);
      process.stderr.write(line);
      logStream.write(line);
    }
  })().catch(() => {});

  // Ctrl+C → SIGTERM to child
  const cleanup = () => {
    console.log('\n🛑 Stopping gateway...');
    try { process.kill(child.pid, 'SIGTERM'); } catch {}
  };
  process.on('SIGINT', cleanup);
  process.on('SIGTERM', cleanup);

  const exitCode = await child.exited;
  await Promise.allSettled([pumpOut, pumpErr]);
  logStream.end();

  try { fs.unlinkSync(PID_FILE); } catch {}

  if (exitCode === 0) {
    console.log('✅ Gateway exited cleanly');
  } else {
    console.log(`⚠️  Gateway exited with code ${exitCode}`);
  }
}

// ================================================================
// stop — stop gateway
// ================================================================
async function cmdStop() {
  if (!fs.existsSync(PID_FILE)) {
    console.log('ℹ️  Gateway is not running');
    return;
  }

  const pid = parseInt(fs.readFileSync(PID_FILE, 'utf-8').trim());
  try {
    process.kill(pid, 0);
    console.log(`⏹  Stopping gateway (PID=${pid})...`);
    process.kill(pid, 'SIGTERM');

    for (let i = 0; i < 20; i++) {
      try {
        process.kill(pid, 0);
        await new Promise(r => setTimeout(r, 500));
      } catch {
        break;
      }
    }

    try {
      process.kill(pid, 0);
      console.log('⚠️  Process not responding, force killing...');
      process.kill(pid, 'SIGKILL');
    } catch {
      console.log('✅ Gateway stopped');
    }
  } catch {
    console.log('ℹ️  Gateway not running (stale PID file cleaned up)');
  }

  try { fs.unlinkSync(PID_FILE); } catch {}
}

// ================================================================
// status — status check
// ================================================================
async function cmdStatus() {
  const dataDir = getDataDir();

  console.log(`\n📊 imtoagent Status`);
  console.log(`   Data directory: ${dataDir}`);

  if (fs.existsSync(PID_FILE)) {
    const pid = parseInt(fs.readFileSync(PID_FILE, 'utf-8').trim());
    try {
      process.kill(pid, 0);
      console.log(`   Process: ✅ Running (PID=${pid})`);
    } catch {
      console.log(`   Process: ❌ Stopped (PID=${pid} does not exist)`);
    }
  } else {
    console.log(`   Process: ⏸  Not running`);
  }

  const configPath = path.join(dataDir, 'config.json');
  if (fs.existsSync(configPath)) {
    try {
      const cfg = JSON.parse(fs.readFileSync(configPath, 'utf-8'));
      const bots = cfg.bots || [];
      console.log(`   Config: ✅ Configured (${bots.length} Bot(s))`);
      for (const bot of bots) {
        console.log(`     - ${bot.name} (${bot.backend})`);
      }
    } catch {
      console.log(`   Config: ❌ Parse error`);
    }
  } else {
    console.log(`   Config: ❌ Not found (run "imtoagent setup")`);
  }

  const logFile = path.join(dataDir, 'logs', 'imtoagent.log');
  if (fs.existsSync(logFile)) {
    const stats = fs.statSync(logFile);
    const size = stats.size > 1024 * 1024
      ? (stats.size / (1024 * 1024)).toFixed(1) + ' MB'
      : (stats.size / 1024).toFixed(1) + ' KB';
    console.log(`   Log: ${size} (${logFile})`);
  }

  console.log();
}

// ================================================================
// restore — hot reload
// ================================================================
async function cmdRestore() {
  if (!fs.existsSync(PID_FILE)) {
    console.error('❌ Gateway is not running, cannot hot reload');
    process.exit(1);
  }

  const pid = parseInt(fs.readFileSync(PID_FILE, 'utf-8').trim());
  console.log(`🔄 Sending SIGHUP to gateway (PID=${pid})...`);
  try {
    process.kill(pid, 'SIGHUP');
    console.log('✅ Hot reload signal sent');
  } catch (e: any) {
    console.error(`❌ Failed to send: ${e.message}`);
    process.exit(1);
  }
}

// ================================================================
// daemon — foreground daemon with auto-restart (for launchd/systemd)
// ================================================================
async function cmdDaemon(): Promise<void> {
  const dataDir = getDataDir();
  const configPath = path.join(dataDir, 'config.json');

  if (!fs.existsSync(configPath)) {
    console.error('❌ No config file found. Please run "imtoagent setup" first');
    process.exit(1);
  }

  const logFile = ensureLogDir(dataDir);
  const { execPath, args } = getGatewayArgs();

  console.log(`🛡  imtoagent Daemon Mode`);
  console.log(`   Data directory: ${dataDir}`);
  console.log(`   Log file: ${logFile}`);
  console.log(`   Press Ctrl+C to stop\n`);

  let shuttingDown = false;
  const shutdown = () => {
    if (shuttingDown) return;
    shuttingDown = true;
    console.log('\n🛑 Received stop signal, shutting down...');
  };

  process.on('SIGTERM', shutdown);
  process.on('SIGINT', shutdown);

  let retryDelay = 0;
  const MAX_RETRY_DELAY = 30_000;

  while (!shuttingDown) {
    if (retryDelay > 0) {
      console.log(`   Waiting ${retryDelay / 1000}s before restart...`);
      await new Promise<void>(resolve => {
        const timer = setTimeout(resolve, retryDelay);
        const check = setInterval(() => {
          if (shuttingDown) {
            clearTimeout(timer);
            clearInterval(check);
            resolve();
          }
        }, 100);
      });
      if (shuttingDown) break;
    }

    // Open log fd for child stdout/stderr
    const logFd = fs.openSync(logFile, 'a');

    const child = spawn(execPath, args, {
      cwd: dataDir,
      env: { ...process.env, IMTOAGENT_HOME: dataDir },
      detached: true,
      stdio: ['ignore', logFd, logFd],
    });

    const childPid = child.pid;
    fs.writeFileSync(PID_FILE, String(childPid));
    console.log(`[${new Date().toISOString()}] 🚀 Starting gateway (PID=${childPid})`);

    let childExitCode: number | null = null;
    await new Promise<void>(resolve => {
      child.on('exit', (code) => { childExitCode = code; resolve(); });
      child.on('error', () => resolve());
    });

    fs.closeSync(logFd);
    try { fs.unlinkSync(PID_FILE); } catch {}

    if (shuttingDown) break;

    if (childExitCode === 0) {
      console.log(`[${new Date().toISOString()}] ⏹  Gateway exited cleanly (code=0), not restarting`);
      break;
    }

    retryDelay = retryDelay === 0 ? 3_000 : Math.min(retryDelay * 2, MAX_RETRY_DELAY);
    console.log(`[${new Date().toISOString()}] ⚠️  Gateway crashed (code=${childExitCode}), restarting in ${retryDelay / 1000}s`);
  }

  console.log('👋 Daemon stopped');
}

// ================================================================
// ================================================================
// update-system — upgrade imtoagent itself (with backup + validation)
// ================================================================
async function cmdUpdateSystem(): Promise<void> {
  const dataDir = getDataDir();
  const configPath = path.join(dataDir, 'config.json');
  const providersPath = path.join(dataDir, 'providers.json');

  const pkg = JSON.parse(fs.readFileSync(new URL('../package.json', import.meta.url), 'utf-8'));
  const currentVer = pkg.version;
  console.log('\n📦 Upgrading imtoagent...');
  console.log(`   Current version: ${currentVer}\n`);

  // Step 1: Backup config files before upgrade
  const backupDir = path.join(dataDir, 'backups', `pre-upgrade-${currentVer}-${Date.now()}`);
  try {
    fs.mkdirSync(backupDir, { recursive: true });
    let backedUp = 0;
    for (const src of [configPath, providersPath]) {
      if (fs.existsSync(src)) {
        const dst = path.join(backupDir, path.basename(src));
        fs.copyFileSync(src, dst);
        backedUp++;
      }
    }
    if (backedUp > 0) {
      console.log(`   ✅ Backed up ${backedUp} config file(s) → ${backupDir}`);
    }
  } catch (e: any) {
    console.log(`   ⚠️  Backup skipped: ${e.message}`);
  }

  console.log('   Running: npm update -g imtoagent\n');

  try {
    const child = Bun.spawn(['zsh', '-ic', 'npm update -g imtoagent'], {
      stdout: 'pipe',
      stderr: 'pipe',
      stdin: 'ignore',
      env: { ...process.env },
    });

    const decoder = new TextDecoder();

    const stdoutReader = child.stdout.getReader();
    while (true) {
      const { done, value } = await stdoutReader.read();
      if (done) break;
      process.stdout.write(decoder.decode(value, { stream: true }));
    }

    const stderrReader = child.stderr.getReader();
    while (true) {
      const { done, value } = await stderrReader.read();
      if (done) break;
      process.stderr.write(decoder.decode(value, { stream: true }));
    }

    const exitCode = await child.exited;
    if (exitCode !== 0) {
      console.error(`\n❌ imtoagent upgrade failed (exit code: ${exitCode})`);
      console.log(`   💡 Backup preserved at: ${backupDir}`);
      process.exit(1);
    }

    // Step 2: Read new version
    let newVer = 'unknown';
    try {
      const newPkg = JSON.parse(fs.readFileSync(new URL('../package.json', import.meta.url), 'utf-8'));
      newVer = newPkg.version;
    } catch {
      // Can't read new version (possibly process swapped), check via CLI
      try {
        newVer = execSync('imtoagent --version', { encoding: 'utf-8', timeout: 5000 }).trim();
      } catch {}
    }

    // Step 3: Validate config after upgrade
    console.log('\n   🔍 Validating configuration...');
    try {
      await cmdValidateQuiet();
      console.log('   ✅ Configuration valid');
    } catch (validationErr: any) {
      console.error(`   ❌ Configuration validation failed after upgrade`);
      console.log(`   🔄 Restoring backup from: ${backupDir}`);
      try {
        for (const src of [configPath, providersPath]) {
          const backupFile = path.join(backupDir, path.basename(src));
          if (fs.existsSync(backupFile)) {
            fs.copyFileSync(backupFile, src);
          }
        }
        console.log('   ✅ Backup restored successfully');
        console.log(`   ⚠️  Please review the backup at: ${backupDir}`);
      } catch (restoreErr: any) {
        console.error(`   ❌ Restore also failed: ${restoreErr.message}`);
      }
      process.exit(1);
    }

    console.log(`\n✅ imtoagent upgraded: ${currentVer} → ${newVer}`);
    console.log(`   Restart gateway with: imtoagent stop && imtoagent start`);
    console.log(`   Backup preserved at: ${backupDir} (delete manually when no longer needed)`);
  } catch (e: any) {
    console.error(`\n❌ Error upgrading imtoagent: ${e.message || e}`);
    console.log(`   💡 Backup preserved at: ${backupDir}`);
    process.exit(1);
  }
}

// ================================================================
// update-backend — upgrade a backend agent
// ================================================================
async function cmdUpdateBackend(backendType?: 'claude' | 'codex' | 'opencode' | 'gemini'): Promise<void> {
  const dataDir = getDataDir();
  const configPath = path.join(dataDir, 'config.json');

  // Determine which backend to upgrade
  let targetType: 'claude' | 'codex' | 'opencode' | 'gemini';

  if (backendType) {
    if (!['claude', 'codex', 'opencode'].includes(backendType)) {
      console.error(`❌ Unknown backend: ${backendType}`);
      console.error(`   Valid: claude, codex, opencode`);
      process.exit(1);
    }
    targetType = backendType;
  } else {
    // Auto-detect from config (use first bot's backend)
    if (!fs.existsSync(configPath)) {
      console.error('❌ No config found. Run "imtoagent setup" first.');
      process.exit(1);
    }
    const cfg = JSON.parse(fs.readFileSync(configPath, 'utf-8'));
    const bots = cfg.bots || [];
    if (bots.length === 0) {
      console.error('❌ No bots configured.');
      process.exit(1);
    }
    targetType = bots[0].backend;
    if (!targetType) {
      console.error('❌ First bot has no backend configured.');
      process.exit(1);
    }
    console.log(`   Auto-detected backend: ${targetType} (from bot: ${bots[0].name})\n`);
  }

  // Show current status
  const { checkBackend } = await import('../modules/utils/backend-check');
  const info = checkBackend(targetType);
  console.log(`   ${info.label}: ${info.version || 'not installed'} (${info.installSource})`);

  if (!info.installed) {
    console.error(`\n❌ ${info.label} not installed.`);
    console.error(`   Install: imtoagent setup`);
    process.exit(1);
  }

  // Run upgrade
  const { upgradeBackend } = await import('../modules/utils/backend-check');
  const result = await upgradeBackend(targetType);

  if (!result.success) {
    process.exit(1);
  }
}

// ================================================================
// uninstall — remove imtoagent
// ================================================================
async function cmdUninstall(): Promise<void> {
  const dataDir = getDataDir();
  const purge = process.argv.includes('--purge');
  const force = process.argv.includes('--force') || process.argv.includes('-f');

  console.log('\n🗑️  imtoagent Uninstall');
  console.log(`   Data directory: ${dataDir}`);

  if (!purge && !force) {
    console.log('\n   ⚠️  This will uninstall the imtoagent npm package but KEEP your data.');
    console.log(`   Your data in ${dataDir} will be preserved.`);
    console.log('');
    console.log('   To also delete all data, use: imtoagent uninstall --purge');
    console.log('');
    console.log('   Continue? [y/N]');
  } else if (purge && !force) {
    console.log('\n   🔴 This will DELETE all imtoagent data and the npm package.');
    console.log(`   The following will be permanently removed:`);
    console.log(`   - Data directory: ${dataDir}`);
    console.log('   - npm global package: imtoagent');
    console.log('');
    console.log('   Continue? [y/N]');
  } else {
    console.log('   --force: skipping confirmation\n');
  }

  // Confirmation
  if (!force) {
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    const answer = await new Promise<string>((resolve) => {
      rl.question('   > ', resolve);
    }).finally(() => rl.close());
    if (answer.trim().toLowerCase() !== 'y' && answer.trim().toLowerCase() !== 'yes') {
      console.log('❌ Uninstall cancelled.');
      return;
    }
  }

  // Step 1: Stop gateway if running
  if (fs.existsSync(PID_FILE)) {
    const pid = parseInt(fs.readFileSync(PID_FILE, 'utf-8').trim());
    try {
      process.kill(pid, 0);
      console.log(`⏹  Stopping gateway (PID=${pid})...`);
      process.kill(pid, 'SIGTERM');
      for (let i = 0; i < 10; i++) {
        try { process.kill(pid, 0); await new Promise(r => setTimeout(r, 500)); } catch { break; }
      }
      try { process.kill(pid, 0); process.kill(pid, 'SIGKILL'); } catch {}
      console.log('✅ Gateway stopped');
    } catch {}
    try { fs.unlinkSync(PID_FILE); } catch {}
  } else {
    console.log('ℹ️  Gateway is not running');
  }

  // Step 2: Remove launchd plist
  const plistPath = path.join(process.env.HOME || '', 'Library', 'LaunchAgents', 'com.imtoagent.gateway.plist');
  if (fs.existsSync(plistPath)) {
    try {
      execSync(`launchctl unload "${plistPath}" 2>/dev/null`, { encoding: 'utf-8' });
      console.log('⏹  Launchd service unloaded');
    } catch {}
    try {
      fs.unlinkSync(plistPath);
      console.log('🗑️  Launchd plist removed');
    } catch {}
  } else {
    console.log('ℹ️  No launchd service configured');
  }

  // Step 3: Uninstall npm package
  console.log('\n📦 Uninstalling npm package...');
  try {
    execSync('npm uninstall -g imtoagent', {
      encoding: 'utf-8',
      stdio: 'inherit',
      timeout: 30000,
    });
    console.log('✅ npm package uninstalled');
  } catch (e: any) {
    console.error(`⚠️  npm uninstall may have failed: ${e.message}`);
  }

  // Step 4: Purge data if requested
  if (purge) {
    console.log(`\n🔥 Deleting data directory: ${dataDir}`);
    try {
      execSync(`rm -rf "${dataDir}"`, { encoding: 'utf-8', timeout: 10000 });
      console.log('✅ Data directory deleted');
    } catch (e: any) {
      console.error(`⚠️  Failed to delete data directory: ${e.message}`);
      console.error(`   Please remove manually: rm -rf "${dataDir}"`);
    }
  } else {
    console.log(`\n💾 Data preserved at: ${dataDir}`);
    console.log('   To remove it later: rm -rf ~/.imtoagent');
  }

  console.log('\n✅ imtoagent uninstalled');
}

// ================================================================
// health — comprehensive health check
// ================================================================
async function cmdHealth(): Promise<void> {
  const dataDir = getDataDir();
  const configPath = path.join(dataDir, 'config.json');
  const logFile = path.join(dataDir, 'logs', 'imtoagent.log');

  console.log(`\n🔍 imtoagent Health Check`);
  console.log(`   Data directory: ${dataDir}`);
  console.log(`   Time: ${new Date().toISOString()}\n`);

  let errorCount = 0;
  let warnCount = 0;

  // ---- 1. Gateway Process ----
  console.log('── Gateway Process ──');
  if (fs.existsSync(PID_FILE)) {
    const pid = parseInt(fs.readFileSync(PID_FILE, 'utf-8').trim());
    try {
      process.kill(pid, 0);
      console.log(`   ✅ Running (PID=${pid})`);
    } catch {
      console.log(`   ❌ PID file exists but process ${pid} is gone (stale)`);
      errorCount++;
    }
  } else {
    console.log(`   ⏸  Not running`);
  }

  // ---- 2. Configuration ----
  console.log('\n── Configuration ──');
  if (fs.existsSync(configPath)) {
    try {
      const cfg = JSON.parse(fs.readFileSync(configPath, 'utf-8'));
      console.log(`   ✅ config.json parse OK`);

      // Check required fields
      if (!cfg.bots || !Array.isArray(cfg.bots) || cfg.bots.length === 0) {
        console.log(`   ⚠️  No bots configured`);
        warnCount++;
      } else {
        console.log(`   ✅ ${cfg.bots.length} Bot(s) configured`);
        for (const bot of cfg.bots) {
          const issues: string[] = [];
          if (!bot.name) issues.push('missing name');
          if (!bot.im) issues.push('missing IM platform');
          if (!bot.backend) issues.push('missing backend');
          if (issues.length > 0) {
            console.log(`   ⚠️  Bot "${bot.name || '?'}": ${issues.join(', ')}`);
            warnCount++;
          } else {
            console.log(`   ✅ ${bot.name} (${bot.im} + ${bot.backend})`);
          }
        }
      }

      // Check providers.json
      const providersPath = path.join(dataDir, 'providers.json');
      if (fs.existsSync(providersPath)) {
        try {
          const prov = JSON.parse(fs.readFileSync(providersPath, 'utf-8'));
          console.log(`   ✅ providers.json parse OK`);
          // Check for placeholder API keys
          const provStr = JSON.stringify(prov);
          if (provStr.includes('YOUR_') || provStr.includes('sk-xxx') || provStr.includes('placehold')) {
            console.log(`   ⚠️  providers.json may contain placeholder API keys`);
            warnCount++;
          }
        } catch {
          console.log(`   ❌ providers.json parse error`);
          errorCount++;
        }
      } else {
        console.log(`   ⚠️  providers.json not found`);
        warnCount++;
      }
    } catch {
      console.log(`   ❌ config.json parse error`);
      errorCount++;
    }
  } else {
    console.log(`   ❌ config.json not found (run "imtoagent setup")`);
    errorCount++;
  }

  // ---- 3. Backend Status ----
  console.log('\n── Backend Status ──');
  try {
    const { checkBackend } = await import('../modules/utils/backend-check');
    if (fs.existsSync(configPath)) {
      const cfg = JSON.parse(fs.readFileSync(configPath, 'utf-8'));
      const checkedTypes = new Set<string>();
      for (const bot of cfg.bots || []) {
        if (bot.backend && ['claude', 'codex', 'opencode'].includes(bot.backend) && !checkedTypes.has(bot.backend)) {
          checkedTypes.add(bot.backend);
          const info = checkBackend(bot.backend as any);
          if (info.installed) {
            console.log(`   ✅ ${info.label} v${info.version} (${info.installSource})`);
          } else {
            console.log(`   ❌ ${info.label} not installed → ${info.installHint}`);
            errorCount++;
          }
        }
      }
      if (checkedTypes.size === 0) {
        console.log(`   ℹ️  No backends to check`);
      }
    }
  } catch {
    console.log(`   ⚠️  Backend check skipped`);
    warnCount++;
  }

  // ---- 4. Proxy Port ----
  console.log('\n── Proxy Port (:18899) ──');
  try {
    const net = await import('net');
    const checkPort = (port: number): Promise<boolean> => {
      return new Promise((resolve) => {
        const socket = new net.Socket();
        socket.setTimeout(2000);
        socket.on('connect', () => { socket.destroy(); resolve(true); });
        socket.on('error', () => resolve(false));
        socket.on('timeout', () => { socket.destroy(); resolve(false); });
        socket.connect(port, '127.0.0.1');
      });
    };
    const reachable = await checkPort(18899);
    if (reachable) {
      console.log(`   ✅ Port 18899 is reachable`);
    } else {
      // Check if port is in use by another process
      try {
        const lsofOut = execSync(`lsof -i :18899 2>/dev/null`, { encoding: 'utf-8', timeout: 3000 }).trim();
        if (lsofOut) {
          console.log(`   ❌ Port 18899 is occupied by another process:`);
          lsofOut.split('\n').forEach(line => console.log(`      ${line}`));
        } else {
          console.log(`   ⏸  Port 18899 is free (gateway not running)`);
        }
      } catch {
        console.log(`   ⏸  Port 18899 is free (gateway not running)`);
      }
    }
  } catch {
    console.log(`   ⚠️  Port check failed`);
    warnCount++;
  }

  // ---- 5. Recent Log Errors ----
  console.log('\n── Recent Log Errors ──');
  if (fs.existsSync(logFile)) {
    const stats = fs.statSync(logFile);
    const size = stats.size > 1024 * 1024
      ? (stats.size / (1024 * 1024)).toFixed(1) + ' MB'
      : (stats.size / 1024).toFixed(1) + ' KB';
    console.log(`   Log: ${size}`);

    // Read last 50 lines looking for ERROR/WARN
    try {
      const content = fs.readFileSync(logFile, 'utf-8');
      const lines = content.split('\n');
      const recent = lines.slice(-50);
      const errors = recent.filter(l => l.includes('ERROR') || l.includes('[error]'));
      const warns = recent.filter(l => l.includes('WARN') || l.includes('[warn]'));

      if (errors.length > 0) {
        console.log(`   ❌ ${errors.length} recent ERROR(s):`);
        for (const line of errors.slice(-3)) {
          console.log(`      ${line.trim().slice(0, 120)}`);
        }
        errorCount++;
      } else {
        console.log(`   ✅ No recent errors`);
      }
      if (warns.length > 0 && errors.length === 0) {
        console.log(`   ℹ️  ${warns.length} recent warning(s) (non-critical)`);
      }
    } catch {
      console.log(`   ⚠️  Could not read log file`);
      warnCount++;
    }
  } else {
    console.log(`   ℹ️  No log file yet`);
  }

  // ---- Summary ----
  console.log('\n── Summary ──');
  if (errorCount === 0 && warnCount === 0) {
    console.log(`   ✅ All checks passed!`);
  } else {
    if (errorCount > 0) console.log(`   ❌ ${errorCount} error(s)`);
    if (warnCount > 0) console.log(`   ⚠️  ${warnCount} warning(s)`);
  }
  console.log();
}

// ================================================================
// config — Bot 配置管理
// ================================================================
async function cmdConfig(): Promise<void> {
  const subcommand = process.argv[3];

  switch (subcommand) {
    case 'list':
      await cmdConfigList();
      break;
    case 'show': {
      const name = process.argv[4];
      if (!name) { console.error('Usage: imtoagent config show <name>'); process.exit(1); }
      await cmdConfigShow(name);
      break;
    }
    case 'add':
      await cmdConfigAdd();
      break;
    case 'remove': {
      const name = process.argv[4];
      if (!name) { console.error('Usage: imtoagent config remove <name>'); process.exit(1); }
      await cmdConfigRemove(name);
      break;
    }
    case 'modify': {
      const name = process.argv[4];
      if (!name) { console.error('Usage: imtoagent config modify <name>'); process.exit(1); }
      await cmdConfigModify(name);
      break;
    }
    case undefined:
    case 'help':
    case '--help':
    case '-h':
      console.log(`
imtoagent config — Manage Bot configuration

Usage:
  imtoagent config list         List all Bots
  imtoagent config show NAME    Show Bot details
  imtoagent config add          Add a new Bot (interactive)
  imtoagent config remove NAME  Remove a Bot
  imtoagent config modify NAME  Modify Bot settings
`);
      break;
    default:
      console.error(`❌ Unknown config subcommand: ${subcommand}`);
      console.log('   Run "imtoagent config help" for usage.');
      process.exit(1);
  }
}

